    chown shell system /proc/driver/wmt_dbg
    chown shell system /proc/driver/wmt_aee

# define device for EMCSMDLOGGER
    chown system radio /dev/ttyGS3
    chmod 0660 /dev/ttyGS3

#Define device for ATCID
    chmod 660 /dev/ttyGS0
    chown system radio /dev/ttyGS0
    chmod 660 /dev/ttyGS1
    chown system radio /dev/ttyGS1
#Power Manager
    write /sys/power/pm_freeze_timeout 2000

on property:sys.UiBatteryLevel=*
    write proc/charger/ui_soc ${sys.UiBatteryLevel}

on property:sys.boot_completed=1

    # stop bootprof
    write /proc/bootprof 0

#
#  External Modme control related services
#

# Mount mdota
on property:ro.boot.slot_suffix=_a
    # Set SELinux security contexts on upgrade or policy update.
    mount ext4 /dev/block/by-name/mcf_ota_a /mnt/vendor/mdota ro wait noatime

on property:ro.boot.slot_suffix=_b
    # Set SELinux security contexts on upgrade or policy update.
    mount ext4 /dev/block/by-name/mcf_ota_b /mnt/vendor/mdota ro wait noatime

# reset mdmode when modem crash happens in ATM
on property:vendor.mtk.md1.status=reset
    setprop persist.vendor.atm.mdmode normal

service wifi_load_disable_dual_rro /system/bin/cmd -w overlay enable com.android.wifi.disable_dual.resources.overlay
    class main
    user root
    group root
    oneshot
    disabled
    seclabel u:r:su:s0

service wifi_unload_disable_dual_rro /system/bin/cmd -w overlay disable com.android.wifi.disable_dual.resources.overlay
    class main
    user root
    group root
    oneshot
    disabled
    seclabel u:r:su:s0

on property:vendor.connsys.adie.chipid=0x6631
    # load override RRO
    write /dev/kmsg "WifiHAL: Load disable_dual RRO"
    start wifi_load_disable_dual_rro

on property:vendor.connsys.adie.chipid=0x6637
    # unload override RRO
    write /dev/kmsg "WifiHAL: Unload disable_dual RRO"
    start wifi_unload_disable_dual_rro

on property:dev.mnt.blk.data=sdc84 && property:sys.sd.enable=1
    write /sys/dev/block/${sys.sd.devid}/queue/read_ahead_kb 2048
    write /dev/sys/block/by-name/userdata/queue/read_ahead_kb 2048

on property:dev.mnt.blk.data=sdc84 && property:sys.otg.enable=1
    write /sys/dev/block/${sys.otg.devid}/queue/iosched/read_expire 100
    write /sys/dev/block/${sys.otg.devid}/queue/iosched/writes_starved 10
    write /dev/sys/block/by-name/userdata/queue/read_ahead_kb 2048

on property:sys.touch.keyguard.state=*
    write /proc/touchpanel/palm_to_sleep_support ${sys.touch.keyguard.state}

# Double Tap to Wake
on property:vendor.touch.double_tap_to_wake=*
    write /proc/touchpanel/gesture_mode ${vendor.touch.double_tap_to_wake}

on property:sys.touch.game_mode.enable=*
    write /proc/touchpanel/game_mode ${sys.touch.game_mode.enable}

on property:sys.touch.edge_mode.enable=*
    write /proc/touchpanel/edge_mode ${sys.touch.edge_mode.enable}

on property:sys.touch.fod_en.enable=*
    write /proc/touchpanel/fod_mode ${sys.touch.fod_en.enable}

on property:sys.touch.pocket_mode=*
    write /proc/touchpanel/pocket_mode ${sys.touch.pocket_mode}
